<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Required host declaration; binding still goes through ACTION_APPWIDGET_BIND user consent. -->
    <uses-permission android:name="android.permission.BIND_APPWIDGET" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <queries>
        <intent><action android:name="org.adw.launcher.THEMES" /></intent>
        <intent><action android:name="com.gau.go.launcherex.theme" /></intent>
        <intent><action android:name="com.novalauncher.THEME" /></intent>

        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.HOME" /></intent>
        <intent><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent>
        <package android:name="moe.shizuku.privileged.api" />
    </queries>
    <application android:name=".ShellApplication" android:label="StellaShell" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher" android:theme="@style/AppTheme"
        android:localeConfig="@xml/locales_config" android:allowBackup="false" android:dataExtractionRules="@xml/data_extraction_rules" android:supportsRtl="true">
        <activity android:name=".IconSettingsActivity" android:exported="false" android:resizeableActivity="true" android:excludeFromRecents="true" />
        <activity android:name=".PrerequisitesActivity" android:exported="false" />
        <activity android:name=".DisplayManagementActivity" android:exported="false" />
        <activity android:name=".AppearanceActivity" android:exported="false" android:resizeableActivity="true"
            android:launchMode="singleTask" android:taskAffinity="net.fuyumori.stellashell.appearance" android:excludeFromRecents="true" />
        <activity android:name=".SidebarSettingsActivity" android:exported="false" android:resizeableActivity="true"
            android:launchMode="singleTask" android:taskAffinity="net.fuyumori.stellashell.sidebarsettings" android:excludeFromRecents="true" />
        <activity android:name=".TaskbarSettingsActivity" android:exported="false" android:resizeableActivity="true"
            android:launchMode="singleTask" android:taskAffinity="net.fuyumori.stellashell.taskbarsettings" android:excludeFromRecents="true" />
        <activity android:name=".SearchSettingsActivity" android:exported="false" android:resizeableActivity="true"
            android:launchMode="singleTask" android:taskAffinity="net.fuyumori.stellashell.searchsettings" android:excludeFromRecents="true" />
        <activity android:name=".DisplaySettingsActivity" android:exported="false" android:resizeableActivity="true"
            android:launchMode="singleTask" android:taskAffinity="net.fuyumori.stellashell.displaysettings" android:excludeFromRecents="true" />
        <activity android:name=".SetupActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <activity android:name=".ExternalAppActivity" android:exported="false" android:resizeableActivity="true"
            android:taskAffinity="net.fuyumori.stellashell.externalapp" android:excludeFromRecents="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboard|keyboardHidden|density" />
        <activity android:name=".HomeActivity" android:exported="true" android:launchMode="singleTask"
            android:taskAffinity="net.fuyumori.stellashell.home" android:excludeFromRecents="true"
            android:resizeableActivity="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboard|keyboardHidden|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity android:name=".StartMenuActivity" android:exported="true" android:theme="@style/HubTheme"
            android:excludeFromRecents="true" android:taskAffinity="net.fuyumori.stellashell.start" android:resizeableActivity="true">
            <intent-filter>
                <action android:name="android.intent.action.ALL_APPS" />
                <action android:name="launcher.intent_action_all_apps_toggle" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity android:name=".DesktopActivity" android:enabled="false" android:exported="true" android:resizeableActivity="true"
            android:taskAffinity="net.fuyumori.stellashell.external" android:excludeFromRecents="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboard|keyboardHidden|density">
            <intent-filter><action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.SECONDARY_HOME" />
            </intent-filter>
        </activity>
        <activity android:name=".DesktopInteractionActivity" android:exported="false" android:resizeableActivity="true" android:theme="@style/HubTheme"
            android:taskAffinity="net.fuyumori.stellashell.desktopinteraction" android:excludeFromRecents="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboard|keyboardHidden|density" />
        <activity android:name=".HubActivity" android:exported="false" android:resizeableActivity="true"
            android:theme="@style/HubTheme" android:launchMode="singleTask"
            android:taskAffinity="net.fuyumori.stellashell.hub" android:excludeFromRecents="true" />
        <activity android:name=".QuickSettingsActivity" android:exported="false" android:resizeableActivity="true"
            android:theme="@style/HubTheme" android:launchMode="singleTask"
            android:taskAffinity="net.fuyumori.stellashell.quick" android:excludeFromRecents="true" />
        <service android:name=".ShellNotifications" android:exported="true"
            android:label="@string/hub_notification_access_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter><action android:name="android.service.notification.NotificationListenerService" /></intent-filter>
        </service>
        <receiver android:name=".StartMenuReceiver" android:exported="true" android:permission="android.permission.DUMP" />
        <service android:name=".DockService" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="User-enabled external display desktop dock and cable connection monitoring" />
        </service>
        <provider android:name="rikka.shizuku.ShizukuProvider" android:authorities="${applicationId}.shizuku"
            android:multiprocess="false" android:enabled="true" android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
